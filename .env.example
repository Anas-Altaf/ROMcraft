# Local dev: both variables optional (defaults to http://localhost:3000 and no subpath).
# GitHub Actions automatically sets these to the configured GitHub Pages origin and base path.
# If building locally for a project page, replace OWNER/REPO with your actual values.
# NEXT_PUBLIC_SITE_URL=https://OWNER.github.io/REPO
# NEXT_PUBLIC_BASE_PATH=/REPO
# For a custom domain hosted at the root:
# NEXT_PUBLIC_SITE_URL=https://docs.example.com
# NEXT_PUBLIC_BASE_PATH=
