{
  "name": "romcraft-fieldnotes",
  "version": "1.0.0",
  "private": true,
  "description": "Research-led Android modding fieldnotes and Galaxy A10 case study",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run check:content && npm run test && npm run typecheck && npm run lint",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "gray-matter": "^4.0.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rehype-slug": "^6.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
